        {
          "name": "Get Approvals (With Filtering & Pagination)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/approvals?status=PENDING&page=1&pageSize=10&sort=createdAt&sortDirection=desc",
              "host": ["{{baseUrl}}"],
              "path": ["approvals"],
              "query": [
                { "key": "status", "value": "PENDING" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" },
                { "key": "sort", "value": "createdAt" },
                { "key": "sortDirection", "value": "desc" }
              ]
            }
          }
        },
