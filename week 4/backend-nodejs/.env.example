# Environment
NODE_ENV=development
PORT=3000

# Database — SQL Server (Windows Authentication)
DB_SERVER=localhost
DB_DATABASE=ApprovalWorkflowSystem
DB_TRUSTED_CONNECTION=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false

# JWT
JWT_SECRET=week4-approval-workflow-local-dev-secret-change-in-production
JWT_EXPIRES_IN=8h

# CORS
FRONTEND_ORIGIN=http://localhost:5173
