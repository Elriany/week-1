# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS — the Vite dev server origin
FRONTEND_ORIGIN=http://localhost:5173

# Database — SQL Server, Windows Authentication
# DB_SERVER is "." for the local default instance, or ".\SQLEXPRESS" for a named instance.
DB_SERVER=.
DB_DATABASE=CRM
DB_TRUSTED_CONNECTION=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false
# Must match an ODBC driver installed on this machine, at the same bitness as Node.
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Authentication — JWT
# MUST be replaced with a long random value in production. Minimum 16 characters.
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=10

# File uploads — customer attachments
# UPLOAD_DIR is resolved relative to the backend working directory and must NOT be inside src/
# (changes in src/ trigger file watcher restarts, and upload activity would cause constant restarts)
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
